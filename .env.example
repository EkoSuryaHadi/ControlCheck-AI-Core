# Replace every angle-bracket placeholder before deployment. Never commit real values.
CONTROLCHECK_ENV=production
CONTROLCHECK_DATABASE_URL=postgresql+psycopg://<user>:<password>@<managed-postgres-host>:5432/<database>
CONTROLCHECK_UPLOAD_ROOT=/var/lib/controlcheck/uploads
CONTROLCHECK_CATALOGUE=/app/data/controlcheck_rule_catalogue_v0.2.json
CONTROLCHECK_ORGANIZATION_ID=<organization-uuid>
CONTROLCHECK_API_KEY=<generate-a-random-32-plus-character-secret>
CONTROLCHECK_TRUSTED_HOSTS=<api-hostname>
CONTROLCHECK_CORS_ORIGINS=
CONTROLCHECK_ENABLE_DOCS=false
CONTROLCHECK_MAX_UPLOAD_BYTES=26214400
PORT=8000
