# ==============================================================================
# ControlCheck AI — Production Environment Variables Template
# ==============================================================================

# 1. Database Configuration
POSTGRES_USER=controlcheck
POSTGRES_PASSWORD=your-super-secure-production-db-password
POSTGRES_DB=controlcheck
POSTGRES_PORT=5432
CONTROLCHECK_DATABASE_URL=postgresql+psycopg://controlcheck:your-super-secure-production-db-password@postgres:5432/controlcheck

# 2. Security & JWT Configuration
# Generate with: openssl rand -hex 32
CONTROLCHECK_JWT_SECRET=your-32-byte-hex-secret-key-for-jwt-signing
CONTROLCHECK_JWT_ALGORITHM=HS256
CONTROLCHECK_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 3. CORS Whitelist (comma-separated domains)
CONTROLCHECK_CORS_ORIGINS=https://app.controlcheck.ai,https://admin.controlcheck.ai

# 4. Storage Configuration (local | s3)
CONTROLCHECK_STORAGE_BACKEND=local
CONTROLCHECK_UPLOAD_ROOT=var/uploads

# AWS S3 / MinIO Configuration (Required if CONTROLCHECK_STORAGE_BACKEND=s3)
# CONTROLCHECK_S3_BUCKET=controlcheck-production-uploads
# CONTROLCHECK_S3_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# CONTROLCHECK_S3_ENDPOINT_URL=https://s3.ap-southeast-1.amazonaws.com

# 5. Application Ports & Paths
API_PORT=8000
CONTROLCHECK_CATALOGUE=data/controlcheck_rule_catalogue_v0.2.json
