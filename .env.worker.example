# ==============================================================================
# ControlCheck AI — VPS Worker Environment Variables
# Copy to .env.worker and fill in real values. NEVER commit this file.
# ==============================================================================

# 1. Shared PostgreSQL (Supabase session pooler, port 5432)
CONTROLCHECK_DATABASE_URL=postgresql+psycopg://postgres:replace-with-password@your-project.pooler.supabase.com:5432/postgres

# 2. Security (must match the API deployment)
CONTROLCHECK_JWT_SECRET=replace-with-same-32-byte-hex-secret-as-api

# 3. Workbook storage — Cloudflare R2 (S3-compatible)
CONTROLCHECK_STORAGE_BACKEND=s3
CONTROLCHECK_S3_BUCKET=controlcheck-beta-workbooks
CONTROLCHECK_S3_REGION=auto
CONTROLCHECK_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 4. Rule catalogue (inside the image)
CONTROLCHECK_CATALOGUE=data/controlcheck_rule_catalogue_v0.2.json

# 5. Redis broker (internal compose network — normally leave as-is)
CONTROLCHECK_REDIS_URL=redis://redis:6379/0

# 6. MS Project (.mpp) parsing (worker only) — MPXJ needs a JVM.
# The Docker image sets JAVA_HOME automatically; override only for custom paths.
CONTROLCHECK_JAVA_HOME=
