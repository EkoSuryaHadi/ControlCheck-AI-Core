{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build && cp -r dist/* ../public/",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.py": {
      "runtime": "@vercel/python@4.5.1"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
