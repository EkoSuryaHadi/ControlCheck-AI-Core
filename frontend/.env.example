# Frontend Environment Variables
# For local development with Vite proxy, leave empty or unset:
# VITE_API_BASE_URL=

# For Production (e.g. Vercel pointing to backend FastAPI server):
# API base URL. When unset the app calls the same origin at /v1
# (FastAPI serves both the SPA and the API). For a split deployment, point
# this at the API origin INCLUDING the /v1 prefix, e.g.:
# VITE_API_BASE_URL=https://api.yourdomain.com/v1
