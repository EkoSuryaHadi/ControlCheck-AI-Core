# Frontend Environment Variables
# For local development with Vite proxy, leave empty or unset:
# VITE_API_BASE_URL=

# For Production (e.g. Vercel pointing to backend FastAPI server):
# API base URL (origin only — the API paths already include /v1/...).
# When unset the app calls the same origin (FastAPI serves both SPA and API).
# For a split deployment point this at the API origin WITHOUT a path suffix:
# VITE_API_BASE_URL=https://api.yourdomain.com
