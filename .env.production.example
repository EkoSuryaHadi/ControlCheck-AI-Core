# ==============================================================================
# ControlCheck AI — Production Environment Configuration
# Copy this file to .env and adjust all secrets before starting services.
# ==============================================================================

# Application Environment
ENV=production
CONTROLCHECK_ENV=production

# Security & Authentication (MANDATORY: Generate with `openssl rand -hex 32`)
CONTROLCHECK_JWT_SECRET=replace-with-secure-32-byte-hex-secret-generated-by-openssl
CONTROLCHECK_ACCESS_TOKEN_EXPIRE_MINUTES=60
CONTROLCHECK_REFRESH_TOKEN_EXPIRE_DAYS=30

# Production Database (PostgreSQL 16)
POSTGRES_USER=controlcheck_admin
POSTGRES_PASSWORD=replace-with-strong-db-password-16-chars-min
POSTGRES_DB=controlcheck_prod
POSTGRES_PORT=5432
CONTROLCHECK_DATABASE_URL=postgresql+psycopg://controlcheck_admin:replace-with-strong-db-password-16-chars-min@postgres:5432/controlcheck_prod

# CORS Allowed Origins (Comma-separated exact domains, never use wildcard '*' in production)
CONTROLCHECK_CORS_ORIGINS=https://app.controlcheck.ai,https://admin.controlcheck.ai

# Rule Catalogue & Storage Paths
CONTROLCHECK_CATALOGUE=data/controlcheck_rule_catalogue_v0.2.json
CONTROLCHECK_MAX_UPLOAD_BYTES=26214400

# Storage Backend: 'local' or 's3'
CONTROLCHECK_STORAGE_BACKEND=local
CONTROLCHECK_UPLOAD_ROOT=var/uploads

# AWS S3 / MinIO Settings (Required if CONTROLCHECK_STORAGE_BACKEND=s3)
# CONTROLCHECK_S3_BUCKET=controlcheck-prod-workbooks
# CONTROLCHECK_S3_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# CONTROLCHECK_S3_ENDPOINT_URL=

# Server Ports & Concurrency
HTTP_PORT=80
HTTPS_PORT=443
API_PORT=8000
WEB_CONCURRENCY=4
