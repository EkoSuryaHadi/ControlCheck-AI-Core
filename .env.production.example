# ==============================================================================
# ControlCheck AI — Production Environment Configuration
# Copy this file to .env and adjust all secrets before starting services.
# ==============================================================================

# Application Environment
ENV=production
CONTROLCHECK_ENV=production

# Security & Authentication (MANDATORY: Generate with `openssl rand -hex 32`)
CONTROLCHECK_JWT_SECRET=replace-with-secure-32-byte-hex-secret-generated-by-openssl
CONTROLCHECK_ACCESS_TOKEN_EXPIRE_MINUTES=60
CONTROLCHECK_REFRESH_TOKEN_EXPIRE_DAYS=30

# Production Database (Supabase Session Pooler, port 5432)
# On Render, supply this connection URL as a secret; do not commit its password.
CONTROLCHECK_DATABASE_URL=postgresql+psycopg://postgres:replace-with-supabase-password@your-project.pooler.supabase.com:5432/postgres

# CORS Allowed Origins (Comma-separated exact domains, never use wildcard '*' in production)
CONTROLCHECK_CORS_ORIGINS=https://control-check-ai-git-codex-public-8a91d7-ekosuryahadis-projects.vercel.app
CONTROLCHECK_TRUSTED_HOSTS=controlcheck-api.onrender.com

# Rule Catalogue & Storage Paths
CONTROLCHECK_CATALOGUE=data/controlcheck_rule_catalogue_v0.2.json
CONTROLCHECK_MAX_UPLOAD_BYTES=26214400

# Public-beta Storage Backend: Cloudflare R2 through its S3-compatible API
CONTROLCHECK_STORAGE_BACKEND=s3
CONTROLCHECK_S3_BUCKET=controlcheck-beta-workbooks
CONTROLCHECK_S3_REGION=auto
# Supply the account-specific endpoint and scoped R2 credentials as Render secrets.
CONTROLCHECK_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=


# Server Ports & Concurrency
HTTP_PORT=80
HTTPS_PORT=443
API_PORT=8000
WEB_CONCURRENCY=4
